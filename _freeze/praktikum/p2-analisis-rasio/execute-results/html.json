.00);border-left: 0 solid rgba(0, 0, 0, 1.00);border-right: 0 solid rgba(0, 0, 0, 1.00);margin-bottom:0;margin-top:0;margin-left:0;margin-right:0;}.cl-0f38724f{width:1.531in;background-color:transparent;vertical-align: middle;border-bottom: 0 solid rgba(255, 255, 255, 0.00);border-top: 0 solid rgba(255, 255, 255, 0.00);border-left: 0 solid rgba(255, 255, 255, 0.00);border-right: 0 solid rgba(255, 255, 255, 0.00);margin-bottom:0;margin-top:0;margin-left:0;margin-right:0;}.cl-0f387258{width:0.775in;background-color:transparent;vertical-align: middle;border-bottom: 0 solid rgba(255, 255, 255, 0.00);border-top: 0 solid rgba(255, 255, 255, 0.00);border-left: 0 solid rgba(255, 255, 255, 0.00);border-right: 0 solid rgba(255, 255, 255, 0.00);margin-bottom:0;margin-top:0;margin-left:0;margin-right:0;}</style><table data-quarto-disable-processing='true' class='cl-0f4094ec'><thead><tr style=\"overflow-wrap:break-word;\"><th class=\"cl-0f387226\"><p class=\"cl-0f381cae\"><span class=\"cl-0f32e36a\">Characteristic</span></p></th><th class=\"cl-0f38723a\"><p class=\"cl-0f381cc2\"><span class=\"cl-0f32e36a\">N = 198</span><span class=\"cl-0f32e374\">1</span></p></th></tr></thead><tbody><tr style=\"overflow-wrap:break-word;\"><td class=\"cl-0f38723b\"><p class=\"cl-0f381ccc\"><span class=\"cl-0f32e37e\">Efisiensi Rawat Jalan</span></p></td><td class=\"cl-0f38723c\"><p class=\"cl-0f381cd6\"><span class=\"cl-0f32e37e\">61 (31%)</span></p></td></tr><tr style=\"overflow-wrap:break-word;\"><td class=\"cl-0f38723b\"><p class=\"cl-0f381ccc\"><span class=\"cl-0f32e37e\">Efisiensi Rawat Inap</span></p></td><td class=\"cl-0f38723c\"><p class=\"cl-0f381cd6\"><span class=\"cl-0f32e37e\">59 (30%)</span></p></td></tr><tr style=\"overflow-wrap:break-word;\"><td class=\"cl-0f387244\"><p class=\"cl-0f381ccc\"><span class=\"cl-0f32e37e\">Efisiensi Hari Rawat</span></p></td><td class=\"cl-0f38724e\"><p class=\"cl-0f381cd6\"><span class=\"cl-0f32e37e\">54 (27%)</span></p></td></tr></tbody><tfoot><tr style=\"overflow-wrap:break-word;\"><td  colspan=\"2\"class=\"cl-0f38724f\"><p class=\"cl-0f381cd7\"><span class=\"cl-0f32e388\">1</span><span class=\"cl-0f32e37e\">n (%)</span></p></td></tr></tfoot></table></div>\n```\n\n:::\n:::\n\n\n## Analisis variabel kontekstual\n\n### Analisis bivariat\n\nBiaya satuan tidak berdistribusi normal, sehingga kita menggunakan nilai\nlogaritmanya.\n\n\n::: {#fig-p-hist .cell layout-ncol=\"2\" layout-align=\"center\"}\n\n```{.r .cell-code}\nhospital <- hospital |>\n  mutate(\n    lnuc_ip = log(unitcost_ip),\n    lnuc_op = log(unitcost_op),\n    lnuc_bd = log(unitcost_bd)\n  )\n\nhospital |>\n  ggplot() +\n  geom_histogram(aes(x = unitcost_ip), bins = 30)\n\nhospital |>\n  ggplot() +\n  geom_histogram(aes(x = lnuc_ip), bins = 30, color = \"black\", fill = \"darkseagreen\")\n```\n\n::: {.cell-output-display}\n![Biaya satuan](p2-analisis-rasio_files/figure-html/fig-p-hist-1.png){#fig-p-hist-1 fig-align='center' width=85%}\n:::\n\n::: {.cell-output-display}\n![Log biaya satuan](p2-analisis-rasio_files/figure-html/fig-p-hist-2.png){#fig-p-hist-2 fig-align='center' width=85%}\n:::\n\nDistribusi biaya satuan rawat inap sebelum dan sesudah transformasi logaritma\n:::\n\n\n\n::: {.cell layout-align=\"center\"}\n\n```{.r .cell-code}\nhospital |>\n  ggplot() +\n  geom_boxplot(aes(x = classCD, y = unitcost_ip)) +\n  labs(x = \"Kelas Rumah Sakit\", y = \"Biaya Satuan Rawat Inap\")\n```\n\n::: {.cell-output-display}\n![Biaya satuan rawat inap menurut kelas rumah sakit](p2-analisis-rasio_files/figure-html/fig-p-boxplot-1.png){#fig-p-boxplot fig-align='center' width=85%}\n:::\n:::\n\n\n\n::: {#tbl-p-ttest .cell layout-align=\"center\" tbl-cap='Perbedaan rerata log biaya satuan menurut kepemilikan rumah sakit (uji-t)'}\n\n```{.r .cell-code}\nhospital |>\n  select(lnuc_op, lnuc_ip, lnuc_bd, publichospital) |>\n  tbl_summary(\n    by = publichospital,\n    digits = all_continuous() ~ 3,\n    statistic = all_continuous() ~ \"{mean} ({sd})\"\n  ) |>\n  add_p(test = all_continuous() ~ \"t.test\") |>\n  as_flex_table()\n```\n\n::: {.cell-output-display}\n\n```{=html}\n<div class=\"tabwid\"><style>.cl-109d9e98{}.cl-10900bfc{font-family:'Arial';font-size:11pt;font-weight:bold;font-style:normal;text-decoration:none;color:rgba(0, 0, 0, 1.00);background-color:transparent;}.cl-10900c06{font-family:'Arial';font-size:11pt;font-weight:normal;font-style:normal;text-decoration:none;color:rgba(0, 0, 0, 1.00);background-color:transparent;}.cl-10900c10{font-family:'Arial';font-size:6.6pt;font-weight:normal;font-style:normal;text-decoration:none;color:rgba(0, 0, 0, 1.00);background-color:transparent;vertical-align:super;}.cl-10900c11{font-family:'Arial';font-size:10pt;font-weight:normal;font-style:normal;text-decoration:none;color:rgba(0, 0, 0, 1.00);background-color:transparent;}.cl-10900c1a{font-family:'Arial';font-size:6pt;font-weight:normal;font-style:normal;text-decoration:none;color:rgba(0, 0, 0, 1.00);background-color:transparent;vertical-align:super;}.cl-1095ac38{margin:0;text-align:left;border-bottom: 0 solid rgba(0, 0, 0, 1.00);border-top: 0 solid rgba(0, 0, 0, 1.00);border-left: 0 solid rgba(0, 0, 0, 1.00);border-right: 0 solid rgba(0, 0, 0, 1.00);padding-bottom:2pt;padding-top:2pt;padding-left:3pt;padding-right:3pt;line-height: 1;background-color:transparent;}.cl-1095ac56{margin:0;text-align:center;border-bottom: 0 solid rgba(0, 0, 0, 1.00);border-top: 0 solid rgba(0, 0, 0, 1.00);border-left: 0 solid rgba(0, 0, 0, 1.00);border-right: 0 solid rgba(0, 0, 0, 1.00);padding-bottom:2pt;padding-top:2pt;padding-left:3pt;padding-right:3pt;line-height: 1;background-color:transparent;}.cl-1095ac60{margin:0;text-align:left;border-bottom: 0 solid rgba(0, 0, 0, 1.00);border-top: 0 solid rgba(0, 0, 0, 1.00);border-left: 0 solid rgba(0, 0, 0, 1.00);border-right: 0 solid rgba(0, 0, 0, 1.00);padding-bottom:3pt;padding-top:3pt;padding-left:3pt;padding-right:3pt;line-height: 1;background-color:transparent;}.cl-1095ac61{margin:0;text-align: